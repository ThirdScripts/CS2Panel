  let brightness=(r+g+b)/3
  if (original === "#041722") return kitty ? "#ffffff" : "#101510"
  if (b-r>65 && g>170) return kitty ? "#b52462" : "#a6db84"
  if (r>180 && r>g*1.2) return kitty ? "#a61d4c" : "#f2a6a6"
  if (brightness>170) return kitty ? "#45283b" : "#e1e7dc"
  if (brightness>75) return kitty ? "#82556c" : "#a0ad98"
  if (brightness>45) return kitty ? "#e9adc6" : "#374735"
  if (brightness>25) return kitty ? "#ffe6ef" : "#192019"
  return kitty ? "#fff7fa" : "#0d120f"
